# ============================================================
#  IT Knowledge Base Bot  -  config file
#  Open this file with Notepad. Fill in the two lines below.
#  Save with encoding = UTF-8.
# ============================================================

# ---- Fill these two lines (from WeCom admin) ----
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# ---- Maintainer (who can approve changes) ----
# KB_MAINTAINER_ID   = WeCom userid of ZhongYong
# KB_MAINTAINER_NAME = display name shown to users
KB_MAINTAINER_ID=ZhongYong
KB_MAINTAINER_NAME=钟勇

# ---- Mode ----
# 0 = real long connection to WeCom (normal use)
# 1 = local mock mode, no WeCom (self test only)
KB_MOCK=0

# ============================================================
#  AI 自然语言改库（可选）
#  开启后：钟勇/目录负责人可在企微里用「/ai 把XX改成YY」直接改库
#  未开启：不影响其它功能，仍可用 /add /edit /del 手动改库
# ============================================================
# 1 = 启用 AI 改库；0 = 关闭
AI_ENABLED=0

# OpenAI 兼容的服务地址（三选一，填你在用的那家）
#   阿里云百炼： https://dashscope.aliyuncs.com/compatible-mode/v1
#   DeepSeek  ： https://api.deepseek.com/v1
#   公司内部网关： https://你的地址/v1
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# API Key（申请到后填这里，sk- 开头）
AI_API_KEY=

# 模型名（百炼：qwen-plus / qwen-turbo；DeepSeek：deepseek-chat）
AI_MODEL=qwen-plus

# 调用超时（秒）
AI_TIMEOUT=20

# ============================================================
#  在线升级（可选）：让钟勇在企微里发 /update 自动升级
#  三个来源，配哪个用哪个（优先级：URL > GIT > DIR）
#  不配也能用「双击 更新.bat」本地升级
# ============================================================
# ① 网址：指到一个 .zip 升级包的固定直链
# KB_UPDATE_URL=https://your-host/kb/latest.zip

# ② Git 仓库：机器人会自动 git clone
# KB_UPDATE_GIT=https://gitee.com/you/it-kb-bot.git
# KB_UPDATE_GIT_BRANCH=main

# ③ 本地目录：取目录里最新的 .zip（默认就是 F:\KIDE_BOT_update）
KB_UPDATE_DIR=F:\KIDE_BOT_update

# ---- 自动升级（零操作）：定时检查更新源，有新版自动拉取并重启 ----
# 1 = 开启自动升级；0 = 关闭（改为在企微里手动发 /update）
KB_AUTO_UPDATE=0
# 检查间隔（分钟）；建议 10~60，最小 1
KB_AUTO_UPDATE_INTERVAL=10

